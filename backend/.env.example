# Copy to .env and fill in. Load with `export $(cat .env | xargs)` or a tool
# like python-dotenv / direnv before running the server.

DOG_TAG_DATABASE_URL=sqlite:///./dogtag.db

# Google Find Hub / Find My Device network, via GoogleFindMyTools.
FMDN_ENABLED=false
FMDN_SECRETS_PATH=./Auth/secrets.json

# Tractive, via aiotractive.
TRACTIVE_EMAIL=
TRACTIVE_PASSWORD=

# Any webhook that accepts a POST with a Title header + text body works
# (e.g. https://ntfy.sh/your-topic-name).
NOTIFY_WEBHOOK_URL=

POLL_INTERVAL_SECONDS=60
